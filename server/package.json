{
  "name": "@proofboard/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "test": "cross-env NODE_ENV=test DATABASE_URL=file:./test.db prisma migrate deploy && cross-env NODE_ENV=test DATABASE_URL=file:./test.db vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.18.10",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "prisma": "6.12.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "cross-env": "^10.1.0"
  }
}
