generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  datasets     Dataset[]
  reports      Report[]
}

model AuthSession {
  sid       String   @id
  data      String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Dataset {
  id               String   @id @default(cuid())
  userId           String
  name             String
  originalFileName String?
  sourceRecordCount Int     @default(0)
  parsedRowCount    Int     @default(0)
  rejectedRowCount  Int     @default(0)
  columns           Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows             DatasetRow[]
  reports          Report[]

  @@unique([id, userId])
  @@index([userId, createdAt])
}

model DatasetRow {
  id             String   @id @default(cuid())
  datasetId      String
  userId         String
  ordinal        Int
  sourceRow      Int
  sourceLine     Int
  values         Json
  warnings       Json
  rejected       Boolean  @default(false)
  hasWarnings    Boolean  @default(false)
  rejectionReason String?
  dataset        Dataset  @relation(fields: [datasetId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([datasetId, ordinal])
  @@index([datasetId, userId, ordinal])
  @@index([datasetId, userId, rejected])
}

model Report {
  id        String      @id @default(cuid())
  userId    String
  datasetId String
  name      String
  definition Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset   Dataset     @relation(fields: [datasetId, userId], references: [id, userId], onDelete: Cascade)
  shareLinks ShareLink[]

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@index([datasetId, userId])
}

model ShareLink {
  id        String    @id @default(cuid())
  reportId  String
  userId    String
  tokenHash String    @unique
  snapshot  Json?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  report    Report    @relation(fields: [reportId, userId], references: [id, userId], onDelete: Cascade)

  @@index([reportId, userId])
  @@index([expiresAt])
}
